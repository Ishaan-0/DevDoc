{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "out",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "electron/**/*",
    "src/**/*",
    "electron.vite.config.ts",
    "electron-builder.config.ts"
  ]
}
